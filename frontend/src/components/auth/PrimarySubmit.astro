---
// PrimarySubmit — a Shadcn-style primary submit button with optional
// leading icon and a built-in spinner that toggles on/off.
//
// The button is rendered as <button type="submit">. The client script
// flips the [data-spinner] visibility and the [data-label] text while
// the request is in flight.

interface Props {
  /** Button label shown by default. */
  label: string;
  /** Optional leading icon. */
  icon?: "arrow-right" | "user-plus" | "log-in";
  /** Submit button id (useful for testing and as an aria target). */
  id?: string;
}

const { label, icon = "arrow-right", id = "submit-button" } = Astro.props;
---

<button
  type="submit"
  id={id}
  data-primary-submit
  data-loading="false"
  class="primary-submit group relative inline-flex h-11 w-full cursor-pointer items-center justify-center gap-2 overflow-hidden rounded-xl border-0 font-sans text-[0.9rem] font-semibold tracking-[0.01em] text-white transition-all duration-200 disabled:cursor-not-allowed disabled:opacity-70 isolate before:absolute before:inset-0 before:-z-[1] before:translate-x-[-100%] before:bg-[linear-gradient(135deg,transparent,rgba(255,255,255,0.12),transparent)] before:transition-transform before:duration-300 before:ease-in-out before:content-[''] hover:-translate-y-px hover:shadow-[0_0_0_1px_rgba(16,185,129,0.45),0_14px_30px_-10px_rgba(16,185,129,0.55)] hover:before:translate-x-[100%] focus-visible:outline-none focus-visible:shadow-[0_0_0_3px_rgba(16,185,129,0.35),0_0_0_1px_rgba(16,185,129,0.55)] active:translate-y-0"
>
  <span
    aria-hidden="true"
    class="primary-submit-bg absolute inset-0 -z-[1] bg-[linear-gradient(135deg,#10b981_0%,#059669_100%)] transition-[background] duration-250 ease group-hover:bg-[linear-gradient(135deg,#34d399_0%,#10b981_100%)]"
  ></span>
  <span data-label class="primary-submit-label transition-opacity duration-150">
    {label}
  </span>
  <span
    aria-hidden="true"
    class="primary-submit-icon inline-flex h-[1.05rem] w-[1.05rem] items-center justify-center transition-transform duration-200 group-hover:not-disabled:translate-x-0.5 [&_svg]:h-full [&_svg]:w-full"
  >
    {icon === "arrow-right" && (
      <svg data-arrow xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    )}
    {icon === "user-plus" && (
      <svg data-arrow xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
        <circle cx="8.5" cy="7" r="4"></circle>
        <line x1="20" y1="8" x2="20" y2="14"></line>
        <line x1="23" y1="11" x2="17" y2="11"></line>
      </svg>
    )}
    {icon === "log-in" && (
      <svg data-arrow xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
        <polyline points="10 17 15 12 10 7"></polyline>
        <line x1="15" y1="12" x2="3" y2="12"></line>
      </svg>
    )}
  </span>
  <svg
    data-spinner
    aria-hidden="true"
    xmlns="http://www.w3.org/2000/svg"
    fill="none"
    viewBox="0 0 24 24"
    class="primary-submit-spinner absolute hidden h-[1.15rem] w-[1.15rem] animate-primary-submit-spin text-white"
  >
    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 0 1 8-8v4a4 4 0 0 0-4 4H4z"></path>
  </svg>
</button>