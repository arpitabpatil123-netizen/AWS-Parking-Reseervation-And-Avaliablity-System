---
// AuthFormField — a Shadcn-style labeled input field with optional
// leading icon and trailing adornment (e.g. password visibility toggle).
// Pure HTML/Tailwind so it hydrates instantly without React.

interface Props {
  /** Field id (also used as the `for` attribute on the label). */
  id: string;
  /** Field name (submitted with the form). */
  name: string;
  /** Field label text shown above the input. */
  label: string;
  /** Input type. */
  type?: "text" | "email" | "password";
  /** Placeholder shown when the input is empty. */
  placeholder?: string;
  /** Autocomplete hint. */
  autocomplete?: string;
  /** Whether the field is required. */
  required?: boolean;
  /** Minimum allowed length (used for validation hints). */
  minlength?: number;
  /** Maximum allowed length. */
  maxlength?: number;
  /** Default value (useful for quick-fill buttons). */
  value?: string;
  /** Lucide-style SVG for the leading icon slot. */
  icon?: "mail" | "lock" | "user" | "car" | "shield";
}

const {
  id,
  name,
  label,
  type = "text",
  placeholder,
  autocomplete,
  required = false,
  minlength,
  maxlength,
  value,
  icon,
} = Astro.props;

const inputPadLeft = icon ? "pl-[2.65rem]" : "pl-[0.95rem]";
const inputPadRight = type === "password" ? "pr-[2.65rem]" : "pr-[0.95rem]";
---

<div class="flex flex-col gap-[0.45rem]" data-field-type={type}>
  <label for={id} class="text-[0.8rem] font-semibold tracking-[0.01em] text-slate-700 dark:text-slate-300">{label}</label>

  <div class="auth-input-wrap relative flex items-center" data-field-wrap>
    {icon && (
      <span
        aria-hidden="true"
        class={`auth-input-icon pointer-events-none absolute left-[0.875rem] top-1/2 z-[1] inline-flex h-[1.05rem] w-[1.05rem] -translate-y-1/2 items-center justify-center text-slate-400 transition-colors duration-200 dark:text-slate-500 [&_svg]:h-full [&_svg]:w-full ${type === "password" ? "group" : ""}`}
      >
        {icon === "mail" && (
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="4" width="20" height="16" rx="2"></rect>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
          </svg>
        )}
        {icon === "lock" && (
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
        )}
        {icon === "user" && (
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
            <circle cx="12" cy="7" r="4"></circle>
          </svg>
        )}
        {icon === "car" && (
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"></path>
            <circle cx="7" cy="17" r="2"></circle>
            <path d="M9 17h6"></path>
            <circle cx="17" cy="17" r="2"></circle>
          </svg>
        )}
        {icon === "shield" && (
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
        )}
      </span>
    )}

    <input
      id={id}
      name={name}
      type={type}
      placeholder={placeholder}
      autocomplete={autocomplete}
      required={required}
      minlength={minlength}
      maxlength={maxlength}
      value={value}
      class={`auth-input w-full rounded-xl border border-slate-300 bg-white py-[0.7rem] text-[0.9rem] leading-[1.4] text-slate-900 shadow-sm outline-none transition-all duration-200 placeholder:text-slate-400 hover:border-slate-400 hover:bg-slate-50 focus:border-emerald-500 focus:bg-white focus:shadow-[0_0_0_4px_rgba(16,185,129,0.15)] dark:border-slate-700/70 dark:bg-slate-900/65 dark:text-slate-100 dark:placeholder:text-slate-600 dark:hover:border-slate-600/90 dark:hover:bg-slate-900/80 dark:focus:border-emerald-500/60 dark:focus:bg-slate-950/70 dark:focus:shadow-[0_0_0_4px_rgba(16,185,129,0.12)] ${inputPadLeft} ${inputPadRight}`}
    />

    {type === "password" && (
      <button
        type="button"
        class="auth-input-action absolute right-[0.6rem] top-1/2 inline-flex h-7 w-7 -translate-y-1/2 items-center justify-center rounded-md border-0 bg-transparent text-slate-400 transition-all duration-150 hover:bg-slate-200 hover:text-slate-600 dark:text-slate-500 dark:hover:bg-slate-700/50 dark:hover:text-slate-300 [&_svg]:h-4 [&_svg]:w-4"
        data-toggle-password
        aria-label="Toggle password visibility"
        tabindex="-1"
      >
        <svg data-eye-on xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
          <circle cx="12" cy="12" r="3"></circle>
        </svg>
        <svg data-eye-off class="hidden" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"></path>
          <path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"></path>
          <path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"></path>
          <line x1="2" x2="22" y1="2" y2="22"></line>
        </svg>
      </button>
    )}
  </div>

  <slot name="hint" />
</div>
