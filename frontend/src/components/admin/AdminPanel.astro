---
/**
 * Admin Panel container.
 *
 * A consistent surface used everywhere a row of cards / tables / lists
 * needs a clear visual container. Replaces the older glass-card utility
 * with proper layering, padding, and typography hierarchy.
 */

interface Props {
  /** Title rendered in the header row. */
  title?: string;
  /** Optional subtitle below the title. */
  subtitle?: string;
  /** Optional small text rendered on the right side of the header row. */
  meta?: string;
  /** When true, removes the inner padding so tables can go edge-to-edge. */
  flush?: boolean;
  /** Optional data attribute hook for client scripts. */
  dataKey?: string;
}

const { title, subtitle, meta, flush = false, dataKey } = Astro.props as Props;
---

<section
  class="admin-panel bg-[hsl(var(--surface-1))] border border-[hsl(var(--surface-3))] rounded-[0.875rem] shadow-[0_1px_2px_hsl(0_0%_0%/0.04)] overflow-hidden"
  data-panel-key={dataKey}
>
  {(title || subtitle || meta) && (
    <header class="admin-panel__header flex items-start justify-between gap-4 py-[1.1rem] px-[1.25rem] border-b border-[hsl(var(--surface-3))]">
      <div class="admin-panel__heading min-w-0">
        {title && <h2 class="admin-panel__title font-display font-bold text-[1.05rem] leading-[1.3] text-[hsl(var(--text-strong))] m-0">{title}</h2>}
        {subtitle && <p class="admin-panel__subtitle mt-[0.2rem] text-[0.825rem] text-[hsl(var(--text-muted))]">{subtitle}</p>}
      </div>
      {meta && <span class="admin-panel__meta text-[0.75rem] font-semibold uppercase tracking-[0.08em] text-[hsl(var(--text-muted))] whitespace-nowrap">{meta}</span>}
      <div class="admin-panel__actions flex items-center gap-2">
        <slot name="actions" />
      </div>
    </header>
  )}
  <div class:list={["admin-panel__body py-[1.1rem] px-[1.25rem]", flush && "p-0"]}>
    <slot />
  </div>
  <div class="admin-panel__footer py-[0.85rem] px-[1.25rem] border-t border-[hsl(var(--surface-3))] bg-[hsl(var(--surface-2)/0.5)] flex items-center justify-between gap-3 text-[0.8rem] text-[hsl(var(--text-muted))]">
    <slot name="footer" />
  </div>
</section>
