---
/**
 * Admin Dashboard layout.
 *
 * Wraps the admin pages with a left sidebar navigation plus a top bar
 * (containing the page title, search affordance, and user menu). The
 * sidebar is keyboard-accessible, collapses on small screens behind a
 * hamburger toggle, and renders an active-state indicator on the
 * current section.
 *
 * Inner shell layout:
 *   .admin-shell
 *     <aside data-admin-sidebar>  - The fixed sidebar
 *     <div data-admin-content>   - The main content scroll area
 *
 * The sidebar is sticky on >= lg screens and overlays the content on
 * smaller screens. Both behaviors are handled by the data attribute
 * hooks the client-side script reads.
 */

interface NavItem {
  key: string;
  label: string;
  href: string;
  icon: string;
  match?: (pathname: string) => boolean;
}

const pathname = Astro.url.pathname;

const navItems: NavItem[] = [
  {
    key: "overview",
    label: "Overview",
    href: "/admin",
    icon: "overview",
    match: (p) => p === "/admin",
  },
  {
    key: "reservations",
    label: "Reservations",
    href: "/admin/reservations",
    icon: "reservations",
    match: (p) => p.startsWith("/admin/reservations"),
  },
  {
    key: "drivers",
    label: "Drivers",
    href: "/admin/drivers",
    icon: "drivers",
    match: (p) => p.startsWith("/admin/drivers"),
  },
  {
    key: "users",
    label: "Users",
    href: "/admin/users",
    icon: "users",
    match: (p) => p.startsWith("/admin/users"),
  },
  {
    key: "zones",
    label: "Parking Zones",
    href: "/admin/zones",
    icon: "zones",
    match: (p) => p.startsWith("/admin/zones"),
  },
];

// Find the active section so we can highlight the sidebar item and color
// the top bar accent strip accordingly.
const activeItem =
  navItems.find((item) => (item.match ? item.match(pathname) : pathname === item.href)) ??
  navItems[0];

interface Props {
  /** Optional explicit title override (defaults to the active nav label). */
  title?: string;
  /** Optional subtitle for the page header. */
  subtitle?: string;
}

const { title, subtitle } = Astro.props as Props;
const pageTitle = title ?? activeItem.label;
---

<div class="admin-shell min-h-screen w-full" data-admin-shell data-active-key={activeItem.key}>
  <!-- ====================================================================
       Sidebar
       ==================================================================== -->
  <aside
    class="admin-sidebar fixed top-0 left-0 z-40 w-64 h-screen bg-white/92 backdrop-blur-[14px] border-r border-[hsl(214_32%_88%)] text-[hsl(222.2_47%_11%)] transition-[transform,width] duration-250 lg:translate-x-0 max-lg:-translate-x-full dark:bg-[hsl(222.2_47%_9%/0.92)] dark:border-[hsl(217.2_32.6%_17.5%/0.8)] dark:text-[hsl(210_40%_93%)]"
    data-admin-sidebar
    aria-label="Admin navigation"
    aria-hidden="false"
  >
    <div class="admin-sidebar__inner flex flex-col h-full py-5 px-4">
      <!-- Brand block -->
      <a href="/admin" class="admin-sidebar__brand flex items-center gap-3 py-2 px-3 mb-6 rounded-xl text-[hsl(222.2_47%_11%)] transition-colors duration-200 hover:bg-[hsl(214_32%_92%)] dark:text-[hsl(210_40%_93%)] dark:hover:bg-white/[0.04]" aria-label="SpotSync admin home">
        <span class="admin-sidebar__brand-text flex flex-col leading-[1.1]">
          <span class="admin-sidebar__brand-name font-display font-bold text-[1.05rem] tracking-[-0.01em]">SpotSync</span>
          <span class="admin-sidebar__brand-suffix text-[0.7rem] text-[hsl(215_16%_47%)] uppercase tracking-[0.08em] font-medium mt-[0.15rem] dark:text-[hsl(215_20%_65%)]">Admin Console</span>
        </span>
      </a>

      <!-- Nav items -->
      <nav class="admin-sidebar__nav flex-1 min-h-0 overflow-y-auto" aria-label="Sections">
        <ul role="list" class="admin-sidebar__nav-list flex flex-col gap-1">
          {navItems.map((item) => {
            const isActive = item.match ? item.match(pathname) : pathname === item.href;
            return (
              <li class="admin-sidebar__nav-item">
                <a
                  href={item.href}
                  class:list={[
                    "admin-sidebar__nav-link flex items-center gap-3 py-[0.625rem] px-3 rounded-[0.625rem] text-sm font-medium text-[hsl(215_16%_47%)] transition-[background-color,color,border-color] duration-150 border border-transparent no-underline hover:bg-[hsl(214_32%_92%)] hover:text-[hsl(222.2_47%_11%)] dark:text-[hsl(215_20%_65%)] dark:hover:bg-white/[0.04] dark:hover:text-[hsl(210_40%_93%)]",
                    isActive && "admin-sidebar__nav-link--active bg-[hsl(160_84%_92%)] text-[hsl(160_84%_30%)] border-[hsl(160_84%_60%)] font-semibold hover:bg-[hsl(160_84%_92%)] hover:text-[hsl(160_84%_30%)] dark:bg-[hsl(160_84%_39%/0.12)] dark:text-[hsl(160_84%_70%)] dark:border-[hsl(160_84%_39%/0.4)] dark:hover:bg-[hsl(160_84%_39%/0.12)] dark:hover:text-[hsl(160_84%_70%)]",
                  ]}
                  aria-current={isActive ? "page" : undefined}
                >
                  <span class="admin-sidebar__nav-icon inline-flex items-center justify-center w-5 h-5 shrink-0 [&_svg]:w-full [&_svg]:h-full" aria-hidden="true">
                    {item.icon === "overview" && (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="7" height="9" rx="1.5"></rect>
                        <rect x="14" y="3" width="7" height="5" rx="1.5"></rect>
                        <rect x="14" y="12" width="7" height="9" rx="1.5"></rect>
                        <rect x="3" y="16" width="7" height="5" rx="1.5"></rect>
                      </svg>
                    )}
                    {item.icon === "reservations" && (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="4" width="18" height="18" rx="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                        <path d="M8 15h2"></path>
                        <path d="M14 15h2"></path>
                      </svg>
                    )}
                    {item.icon === "drivers" && (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="8" r="4"></circle>
                        <path d="M4 21a8 8 0 0 1 16 0"></path>
                      </svg>
                    )}
                    {item.icon === "users" && (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                        <circle cx="9" cy="7" r="4"></circle>
                        <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                      </svg>
                    )}
                    {item.icon === "zones" && (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="7" height="7" rx="1"></rect>
                        <rect x="14" y="3" width="7" height="7" rx="1"></rect>
                        <rect x="14" y="14" width="7" height="7" rx="1"></rect>
                        <rect x="3" y="14" width="7" height="7" rx="1"></rect>
                      </svg>
                    )}
                  </span>
                  <span class="admin-sidebar__nav-label flex-1 leading-[1.2]">{item.label}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </nav>

      <!-- Footer block: theme + status -->
      <div class="admin-sidebar__footer flex flex-col gap-[0.625rem] mt-4 pt-4 border-t border-[hsl(214_32%_88%)] dark:border-[hsl(217.2_32.6%_17.5%/0.8)]">
        <button
          type="button"
          class="admin-sidebar__theme-toggle flex items-center gap-3 py-2 px-3 rounded-[0.625rem] bg-transparent border border-[hsl(214_32%_88%)] text-[hsl(222.2_47%_11%)] text-[0.85rem] font-medium cursor-pointer transition-colors duration-150 w-full hover:bg-[hsl(214_32%_92%)] dark:border-[hsl(217.2_32.6%_17.5%/0.8)] dark:text-[hsl(210_40%_93%)] dark:hover:bg-white/[0.04]"
          data-action="theme-toggle"
          aria-label="Toggle dark / light theme"
          title="Toggle theme"
        >
          <span class="admin-sidebar__theme-icon inline-flex w-4 h-4 [&_svg]:w-full [&_svg]:h-full" data-theme-icon="sun" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2"></path>
              <path d="M12 20v2"></path>
              <path d="m4.93 4.93 1.41 1.41"></path>
              <path d="m17.66 17.66 1.41 1.41"></path>
              <path d="M2 12h2"></path>
              <path d="M20 12h2"></path>
              <path d="m4.93 19.07 1.41-1.41"></path>
              <path d="m17.66 6.34 1.41-1.41"></path>
            </svg>
          </span>
          <span class="admin-sidebar__theme-icon hidden inline-flex w-4 h-4 [&_svg]:w-full [&_svg]:h-full" data-theme-icon="moon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
            </svg>
          </span>
          <span class="admin-sidebar__theme-label flex-1 text-left" data-theme-label>Theme</span>
        </button>

        <div class="admin-sidebar__status flex items-center gap-2 text-[0.75rem] text-[hsl(215_16%_47%)] px-3 dark:text-[hsl(215_20%_65%)]" aria-hidden="true">
          <span class="admin-sidebar__status-dot w-2 h-2 rounded-full bg-[hsl(160_84%_50%)] shadow-[0_0_0_4px_hsl(160_84%_50%/0.15)]"></span>
          <span class="admin-sidebar__status-label">System online</span>
        </div>
      </div>
    </div>
  </aside>

  <!-- ====================================================================
       Backdrop (mobile only) - dims + blocks taps behind the sidebar.
       ==================================================================== -->
  <div class="admin-sidebar-backdrop fixed inset-0 z-35 bg-[hsl(222_47%_4%/0.55)] backdrop-blur-[2px] opacity-0 pointer-events-none transition-opacity duration-200 max-lg:[&.is-visible]:opacity-100 max-lg:[&.is-visible]:pointer-events-auto" data-admin-sidebar-backdrop aria-hidden="true"></div>

  <!-- ====================================================================
       Main content area
       ==================================================================== -->
  <div class="admin-main lg:ml-64 min-h-screen flex flex-col bg-[hsl(var(--surface-0))]" data-admin-main>
    <header class="admin-topbar sticky top-0 z-20 flex items-center justify-between gap-4 p-4 px-6 bg-[hsl(var(--surface-1)/0.7)] backdrop-blur-[14px] border-b border-[hsl(var(--surface-3)/0.7)]">
      <div class="admin-topbar__left flex items-center gap-3 min-w-0">
        <button
          type="button"
          class="admin-topbar__menu hidden max-lg:inline-flex items-center justify-center w-10 h-10 rounded-[0.625rem] bg-[hsl(var(--surface-2)/0.7)] border border-[hsl(var(--surface-3))] text-[hsl(var(--foreground))] cursor-pointer transition-colors duration-150 hover:bg-[hsl(var(--surface-2))] [&_svg]:w-5 [&_svg]:h-5"
          data-action="toggle-sidebar"
          aria-label="Toggle sidebar"
          aria-controls="data-admin-sidebar"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>

        <div class="admin-topbar__titles min-w-0">
          <p class="admin-topbar__eyebrow text-[0.7rem] font-semibold uppercase tracking-[0.1em] text-[hsl(var(--text-muted))] mb-[0.1rem]">SpotSync</p>
          <h1 class="admin-topbar__title font-display font-bold text-[1.25rem] tracking-[-0.01em] text-[hsl(var(--text-strong))] leading-[1.2] m-0">{pageTitle}</h1>
          {subtitle && <p class="admin-topbar__subtitle mt-[0.2rem] text-[0.825rem] text-[hsl(var(--text-muted))]">{subtitle}</p>}
        </div>
      </div>

      <div class="admin-topbar__right flex items-center gap-3">
      </div>
    </header>

    <main class="admin-content flex-1 p-6">
      <slot />
    </main>
  </div>
</div>

<script>
  /**
   * Admin sidebar controller.
   *
   * 1. Mobile open/close toggle (clicking the hamburger in the topbar).
   * 2. Click-outside-to-close on mobile.
   * 3. Mirrors the theme toggle's behavior so the sidebar icon stays in
   *    sync with the navbar toggle.
   * 4. Listens for the "live" badge label updates from page scripts.
   */
  import { $theme, applyTheme, toggleTheme, type Theme } from "../../store/themeStore";

  const sidebar = document.querySelector<HTMLElement>("[data-admin-sidebar]");
  const backdrop = document.querySelector<HTMLElement>("[data-admin-sidebar-backdrop]");
  const toggleBtn = document.querySelector<HTMLButtonElement>("[data-action='toggle-sidebar']");

  function setSidebarOpen(open: boolean): void {
    if (!sidebar || !backdrop) return;
    sidebar.classList.toggle("is-open", open);
    backdrop.classList.toggle("is-visible", open);
    sidebar.setAttribute("aria-hidden", open ? "false" : "true");
  }

  toggleBtn?.addEventListener("click", () => {
    const isOpen = sidebar?.classList.contains("is-open") ?? false;
    setSidebarOpen(!isOpen);
  });

  backdrop?.addEventListener("click", () => setSidebarOpen(false));

  // Auto-close on Escape.
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setSidebarOpen(false);
  });

  // Theme toggle in the sidebar footer.
  const themeBtn = document.querySelector<HTMLButtonElement>(
    "[data-admin-sidebar] [data-action='theme-toggle']",
  );
  themeBtn?.addEventListener("click", () => {
    const next = toggleTheme();
    applyTheme(next);
    paintThemeIcons(next);
  });

  function paintThemeIcons(theme: Theme): void {
    const sun = document.querySelector<HTMLElement>(
      "[data-admin-sidebar] [data-theme-icon='sun']",
    );
    const moon = document.querySelector<HTMLElement>(
      "[data-admin-sidebar] [data-theme-icon='moon']",
    );
    const label = document.querySelector<HTMLElement>(
      "[data-admin-sidebar] [data-theme-label]",
    );
    if (sun) sun.classList.toggle("hidden", theme !== "dark");
    if (moon) moon.classList.toggle("hidden", theme !== "light");
    if (label) {
      label.textContent = theme === "dark" ? "Switch to light" : "Switch to dark";
    }
  }

  paintThemeIcons($theme.get());
  $theme.listen((next) => {
    applyTheme(next);
    paintThemeIcons(next);
  });

  /**
   * Allow page scripts to update the "Live" badge label (e.g. to show
   * "Updated 5 min ago" after a refresh). Dispatch a CustomEvent on
   * window with `detail.label` to set the text.
   */
  window.addEventListener("spotsync:admin-live-label", (event) => {
    const target = document.querySelector<HTMLElement>("[data-admin-live-label]");
    if (!target) return;
    const detail = (event as CustomEvent<{ label: string }>).detail;
    if (detail && typeof detail.label === "string") {
      target.textContent = detail.label;
    }
  });
</script>
