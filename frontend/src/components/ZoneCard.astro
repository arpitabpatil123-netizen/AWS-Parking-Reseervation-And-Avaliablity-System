---
// ZoneCard.astro
//
// Compact, modern card for a single parking zone in the dashboard.
// Features:
//   - Zone name & Location
//   - Type badge with icon
//   - Total, Available, and Occupied space metrics
//   - Dynamic capacity bar (green > 50%, amber 20-50%, red < 20%)
//   - Interactive/collapsible per-spot parking layout
//   - Reserve button with emergency-lock protection

import {
  CAPACITY_THRESHOLDS,
  ZONE_TYPES,
  ZONE_TYPE_BADGE,
  ZONE_TYPE_ICONS,
  ZONE_TYPE_LABELS,
} from "../lib/constants";
import { capacityFillPercent, formatPricePerHour, getZoneLocation } from "../lib/utils";
import type { ParkingZone } from "../types/zone";

interface Props {
  zone: ParkingZone;
}

const { zone } = Astro.props;

const total = Math.max(0, zone.total_capacity);
const isEmergencyClosed = zone.emergency_closed === true;
const location = getZoneLocation(zone);
const spotHolds = Array.isArray(zone.spot_holds) ? zone.spot_holds : null;
const available = isEmergencyClosed ? 0 : Math.max(0, zone.available_spots);
const occupied = spotHolds
  ? spotHolds.filter((h) => h === 1).length
  : (isEmergencyClosed ? 0 : Math.max(0, total - available));
const showSpotGrid = !isEmergencyClosed && spotHolds !== null && total > 0 && spotHolds.length === total;

const fillPercent = capacityFillPercent(total, available);

// Status label and colors
let barColor = "bg-emerald-500";
let barShadow = "shadow-emerald-500/30";
let statusLabel = "Available";
let statusBadgeClass = "bg-emerald-500/10 text-emerald-300 border-emerald-500/30";

if (isEmergencyClosed) {
  barColor = "bg-red-500";
  barShadow = "shadow-red-500/30";
  statusLabel = zone.emergency_status || "Emergency Closed";
  statusBadgeClass = "bg-red-500/10 text-red-300 border-red-500/30";
} else if (available <= 0) {
  barColor = "bg-red-500";
  barShadow = "shadow-red-500/30";
  statusLabel = "Full";
  statusBadgeClass = "bg-red-500/10 text-red-300 border-red-500/30";
} else if (fillPercent < CAPACITY_THRESHOLDS.LOW) {
  barColor = "bg-red-500";
  barShadow = "shadow-red-500/30";
  statusLabel = "Almost Full";
  statusBadgeClass = "bg-red-500/10 text-red-300 border-red-500/30";
} else if (fillPercent < CAPACITY_THRESHOLDS.MEDIUM) {
  barColor = "bg-amber-500";
  barShadow = "shadow-amber-500/30";
  statusLabel = "Filling Up";
  statusBadgeClass = "bg-amber-500/10 text-amber-300 border-amber-500/30";
}

const TYPE_BADGES: Record<ParkingZone["type"], { icon: string; label: string; classes: string }> = {
  [ZONE_TYPES.EV_CHARGING]: {
    icon: ZONE_TYPE_ICONS.ev_charging,
    label: ZONE_TYPE_LABELS.ev_charging,
    classes: ZONE_TYPE_BADGE.ev_charging,
  },
  [ZONE_TYPES.GENERAL]: {
    icon: ZONE_TYPE_ICONS.general,
    label: ZONE_TYPE_LABELS.general,
    classes: ZONE_TYPE_BADGE.general,
  },
  [ZONE_TYPES.COVERED]: {
    icon: ZONE_TYPE_ICONS.covered,
    label: ZONE_TYPE_LABELS.covered,
    classes: ZONE_TYPE_BADGE.covered,
  },
};

const badge = TYPE_BADGES[zone.type] ?? TYPE_BADGES[ZONE_TYPES.GENERAL];
const priceFormatted = formatPricePerHour(zone.price_per_hour);
const isFull = available <= 0 || isEmergencyClosed;
---

<article
  class="glass-card p-4 sm:p-5 flex flex-col justify-between gap-3.5 rounded-2xl border-slate-700/60 hover:border-emerald-500/40 transition-all duration-200 group relative"
  data-zone-card
  data-zone-id={zone.id}
  data-zone-name={zone.name}
  data-zone-location={location}
  data-zone-type={zone.type}
  data-zone-available={available}
  data-zone-total={total}
  data-zone-occupied={occupied}
  data-zone-closed={isEmergencyClosed ? "true" : "false"}
>
  <!-- Card Header: Title, Location, and Badges -->
  <header class="space-y-1.5">
    <div class="flex items-start justify-between gap-2.5">
      <div class="min-w-0 flex-1">
        <h3 class="font-display text-base sm:text-lg font-bold text-slate-100 group-hover:text-emerald-300 transition-colors leading-snug truncate">
          {zone.name}
        </h3>
        <!-- Location row with map pin -->
        <p class="text-xs text-slate-400 flex items-center gap-1 mt-0.5 truncate" title={location}>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-3.5 h-3.5 text-blue-400 flex-shrink-0">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          <span class="truncate">{location}</span>
        </p>
      </div>

      <!-- Type Badge -->
      <span
        class:list={[
          "inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[11px] font-semibold border flex-shrink-0",
          badge.classes,
        ]}
      >
        {badge.icon === "zap" && (
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="w-3 h-3 text-emerald-400">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
          </svg>
        )}
        {badge.icon === "car" && (
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="w-3 h-3 text-blue-400">
            <path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"></path>
            <circle cx="7" cy="17" r="2"></circle>
            <path d="M9 17h6"></path>
            <circle cx="17" cy="17" r="2"></circle>
          </svg>
        )}
        {badge.icon === "shield" && (
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="w-3 h-3 text-purple-400">
            <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path>
          </svg>
        )}
        <span>{badge.label}</span>
      </span>
    </div>

    <!-- Pricing + Status pill row -->
    <div class="flex items-center justify-between gap-2 pt-1">
      <span class="inline-flex items-center px-2 py-0.5 rounded-md bg-slate-800/80 border border-slate-700/60 text-xs font-semibold text-slate-200">
        {priceFormatted}
      </span>
      <span class:list={["inline-flex items-center px-2 py-0.5 rounded-md text-xs font-semibold border", statusBadgeClass]}>
        {statusLabel}
      </span>
    </div>
  </header>

  <!-- Emergency Warning Banner if closed -->
  {isEmergencyClosed && (
    <div class="rounded-xl border border-red-500/40 bg-red-500/10 p-2.5 text-xs text-red-200 space-y-1">
      <div class="flex items-center gap-1.5 font-bold text-red-300">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-3.5 h-3.5 flex-shrink-0">
          <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
          <line x1="12" y1="9" x2="12" y2="13"></line>
          <line x1="12" y1="17" x2="12.01" y2="17"></line>
        </svg>
        <span>Temporarily Unavailable</span>
      </div>
      <p class="text-[11px] text-red-200/90 leading-tight">
        {zone.emergency_closure_reason || "Zone closed due to safety operations. Reservations disabled."}
      </p>
    </div>
  )}

  <!-- Compact Metrics Row: Total | Available | Occupied -->
  <div class="grid grid-cols-3 gap-2 py-1 px-2.5 rounded-xl bg-slate-900/40 border border-slate-800/60 text-center">
    <div>
      <p class="text-[10px] uppercase font-semibold text-slate-400">Total</p>
      <p class="text-xs font-bold text-slate-200" data-total-count>{total}</p>
    </div>
    <div>
      <p class="text-[10px] uppercase font-semibold text-emerald-400">Available</p>
      <p class="text-xs font-bold text-emerald-300" data-available-count>{available}</p>
    </div>
    <div>
      <p class="text-[10px] uppercase font-semibold text-slate-400">Occupied</p>
      <p class="text-xs font-bold text-slate-300" data-occupied-count>{occupied}</p>
    </div>
  </div>

  <!-- Dynamic capacity progress bar -->
  <div class="space-y-1">
    <div class="flex items-center justify-between text-[11px] text-slate-400">
      <span>Capacity Available</span>
      <span class="font-medium text-slate-300" data-fill-percent>{Math.round(fillPercent)}%</span>
    </div>
    <div class="h-1.5 w-full bg-slate-800/80 rounded-full overflow-hidden border border-slate-700/50">
      <div
        class:list={["h-full rounded-full transition-all duration-500 shadow-sm", barColor, barShadow]}
        style={`width: ${fillPercent}%`}
        data-progress-bar
      ></div>
    </div>
  </div>

  <!-- Collapsible Parking Spot Layout Details -->
  {showSpotGrid && spotHolds && (
    <div class="pt-1">
      <details class="group/details text-xs">
        <summary class="cursor-pointer list-none flex items-center justify-between py-1 text-slate-400 hover:text-slate-200 font-medium transition-colors select-none">
          <span class="flex items-center gap-1.5 text-[11px]">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-3.5 h-3.5 text-emerald-400 group-open/details:rotate-90 transition-transform">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
            Parking Space Details ({available} free)
          </span>
          <span class="text-[10px] text-slate-500 group-open/details:hidden">View spot map</span>
        </summary>

        <div class="mt-2 p-2.5 rounded-xl bg-slate-900/60 border border-slate-800 space-y-2">
          <div class="flex items-center justify-between text-[10px] text-slate-400">
            <span>Spot status layout:</span>
            <span class="flex items-center gap-2">
              <span class="inline-flex items-center gap-1">
                <span class="w-2 h-2 rounded-sm bg-emerald-500/60 border border-emerald-500/40"></span>
                <span>free</span>
              </span>
              <span class="inline-flex items-center gap-1">
                <span class="w-2 h-2 rounded-sm bg-slate-700/60 border border-slate-600/40"></span>
                <span>taken</span>
              </span>
            </span>
          </div>

          <div
            class="grid gap-1 grid-cols-6 sm:grid-cols-8"
            data-spot-grid
            data-zone-id={zone.id}
            aria-label={`${available} of ${total} spots available`}
          >
            {spotHolds.map((held, idx) => (
              <div
                class:list={[
                  "h-6 inline-flex items-center justify-center rounded text-[10px] font-semibold border transition-transform hover:scale-105",
                  held === 1
                    ? "bg-slate-800 text-slate-500 border-slate-700/50"
                    : "bg-emerald-500/15 text-emerald-300 border-emerald-500/30",
                ]}
                title={`Spot #${idx + 1} — ${held === 1 ? "Reserved" : "Available"}`}
                data-spot-index={idx}
                data-spot-state={held === 1 ? "reserved" : "available"}
              >
                {idx + 1}
              </div>
            ))}
          </div>
        </div>
      </details>
    </div>
  )}

  <!-- Reserve Button -->
  <div class="pt-2">
    {isEmergencyClosed ? (
      <button
        type="button"
        class="w-full inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-xl font-semibold text-xs transition-all bg-red-950/40 text-red-400 border border-red-500/40 cursor-not-allowed"
        data-reserve-trigger
        data-zone-id={zone.id}
        data-emergency-blocked="true"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-3.5 h-3.5">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
        </svg>
        <span>Zone Closed — Cannot Reserve</span>
      </button>
    ) : isFull ? (
      <button
        type="button"
        class="w-full inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-xl font-semibold text-xs transition-all bg-slate-800/60 text-slate-500 border border-slate-700/60 cursor-not-allowed"
        data-reserve-trigger
        data-zone-id={zone.id}
        disabled
        aria-disabled="true"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-3.5 h-3.5">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
        </svg>
        <span>Zone Full</span>
      </button>
    ) : (
      <button
        type="button"
        class="w-full inline-flex items-center justify-center gap-1.5 px-3.5 py-2 rounded-xl font-semibold text-xs text-white transition-all bg-gradient-to-r from-emerald-500 to-emerald-600 hover:from-emerald-400 hover:to-emerald-500 shadow-md shadow-emerald-500/20 hover:shadow-emerald-500/40"
        data-reserve-trigger
        data-zone-id={zone.id}
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="w-3.5 h-3.5">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
        </svg>
        <span>Reserve Spot</span>
      </button>
    )}
  </div>
</article>
