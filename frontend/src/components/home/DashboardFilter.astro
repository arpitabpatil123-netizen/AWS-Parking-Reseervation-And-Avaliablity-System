---
// DashboardFilter.astro
//
// Search and filter section for the user dashboard.
// Requirements:
//   - Search input for zone name, location, and ID
//   - Filter tabs for: All Zones, Available, Full, and Emergency
//   - Secondary category filter options (EV Charging, General, Covered)

interface Props {
  className?: string;
}

const { className = "" } = Astro.props;
---

<div
  class:list={[
    "glass-card p-3.5 sm:p-4 rounded-2xl border-slate-700/60 mb-6 space-y-3",
    className,
  ]}
  data-dashboard-filter
>
  <!-- Search input bar -->
  <div class="relative flex-1 min-w-0">
    <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
    </span>
    <input
      id="zone-search"
      type="search"
      placeholder="Search parking zones by name, location, or zone ID…"
      autocomplete="off"
      data-zone-search
      class="w-full pl-10 pr-10 py-2 rounded-xl bg-slate-900/60 border border-slate-700/60 text-slate-100 placeholder:text-slate-500 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500/40 focus:border-emerald-500/40 transition-all"
    />
    <button
      type="button"
      data-zone-search-clear
      class="hidden absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-200 p-1"
      aria-label="Clear search"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-3.5 h-3.5">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <!-- Filter chips strip -->
  <div class="flex flex-wrap items-center justify-between gap-2.5 pt-1">
    <!-- Primary Status Filters: All Zones | Available | Full | Emergency -->
    <div class="flex flex-wrap items-center gap-1.5" role="tablist" aria-label="Status Filters">
      <span class="text-xs font-semibold text-slate-400 mr-1 hidden sm:inline">Filter:</span>

      <!-- All Zones -->
      <button
        type="button"
        role="tab"
        aria-selected="true"
        data-status-filter="all"
        class="status-filter-btn active inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold border transition-all bg-emerald-500/15 text-emerald-300 border-emerald-500/40 shadow-sm"
      >
        <span>All Zones</span>
      </button>

      <!-- Available -->
      <button
        type="button"
        role="tab"
        aria-selected="false"
        data-status-filter="available"
        class="status-filter-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium border transition-all bg-slate-800/40 text-slate-300 border-slate-700/60 hover:bg-slate-700/60 hover:text-slate-100"
      >
        <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
        <span>Available</span>
      </button>

      <!-- Full -->
      <button
        type="button"
        role="tab"
        aria-selected="false"
        data-status-filter="full"
        class="status-filter-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium border transition-all bg-slate-800/40 text-slate-300 border-slate-700/60 hover:bg-slate-700/60 hover:text-slate-100"
      >
        <span class="w-2 h-2 rounded-full bg-amber-400"></span>
        <span>Full</span>
      </button>

      <!-- Emergency -->
      <button
        type="button"
        role="tab"
        aria-selected="false"
        data-status-filter="emergency"
        class="status-filter-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium border transition-all bg-red-500/10 text-red-300 border-red-500/30 hover:bg-red-500/20 hover:text-red-200"
      >
        <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
        <span>Emergency</span>
      </button>
    </div>

    <!-- Secondary Type Filters: Type pills -->
    <div class="flex items-center gap-1 overflow-x-auto py-0.5">
      <span class="text-xs font-semibold text-slate-400 mr-1 hidden md:inline">Type:</span>
      <button
        type="button"
        data-type-filter="all"
        class="type-filter-btn active px-2.5 py-1 rounded-md text-[11px] font-semibold border transition-all bg-slate-700/60 text-slate-200 border-slate-600/60"
      >
        All Types
      </button>
      <button
        type="button"
        data-type-filter="ev_charging"
        class="type-filter-btn px-2.5 py-1 rounded-md text-[11px] font-medium border transition-all bg-slate-800/40 text-slate-400 border-slate-700/60 hover:text-slate-200"
      >
        ⚡ EV
      </button>
      <button
        type="button"
        data-type-filter="general"
        class="type-filter-btn px-2.5 py-1 rounded-md text-[11px] font-medium border transition-all bg-slate-800/40 text-slate-400 border-slate-700/60 hover:text-slate-200"
      >
        🚗 General
      </button>
      <button
        type="button"
        data-type-filter="covered"
        class="type-filter-btn px-2.5 py-1 rounded-md text-[11px] font-medium border transition-all bg-slate-800/40 text-slate-400 border-slate-700/60 hover:text-slate-200"
      >
        🛡️ Covered
      </button>
    </div>
  </div>
</div>

