---
// EmergencyZonesSection.astro
//
// Section 5 in the User Dashboard Layout:
// Dedicated Emergency Zones section displaying emergency-affected parking zones separately.

import type { ParkingZone } from "../../types/zone";
import { getZoneLocation } from "../../lib/utils";

interface Props {
  zones: ParkingZone[];
}

const { zones } = Astro.props;

// Filter emergency-affected zones
const rawEmergencyZones = zones.filter(
  (z) =>
    z.emergency_closed === true ||
    z.emergency_status === "Emergency Active" ||
    z.emergency_status === "Temporarily Unavailable" ||
    z.emergency_status === "Blocked"
);

const emergencyZones = rawEmergencyZones.map((zone) => {
  const location = getZoneLocation(zone);
  const status = zone.emergency_status || "Emergency Active";
  const affectedSpaces = zone.affected_spots ?? zone.total_capacity;
  const reason = zone.emergency_closure_reason || "Scheduled maintenance and safety inspection in progress.";

  let statusStyle = "bg-red-500/15 text-red-300 border-red-500/40";
  if (status === "Temporarily Unavailable") {
    statusStyle = "bg-amber-500/15 text-amber-300 border-amber-500/40";
  } else if (status === "Blocked") {
    statusStyle = "bg-rose-500/15 text-rose-300 border-rose-500/40";
  } else if (status === "Restored") {
    statusStyle = "bg-emerald-500/15 text-emerald-300 border-emerald-500/40";
  }

  return {
    id: zone.id,
    name: zone.name,
    total_capacity: zone.total_capacity,
    location,
    status,
    statusStyle,
    affectedSpaces,
    reason,
  };
});
---

<section id="emergency-zones" class="mb-10 scroll-mt-20" aria-label="Emergency Parking Zones">
  <!-- Section Title -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 mb-4">
    <div>
      <div class="flex items-center gap-2">
        <span class="w-7 h-7 rounded-lg bg-red-500/20 border border-red-500/40 flex items-center justify-center text-red-400">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="w-4 h-4">
            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
            <line x1="12" y1="9" x2="12" y2="13"></line>
            <line x1="12" y1="17" x2="12.01" y2="17"></line>
          </svg>
        </span>
        <h2 class="font-display text-xl sm:text-2xl font-bold text-slate-100">
          Emergency Zones
        </h2>
        <span
          class="px-2 py-0.5 rounded-full text-xs font-bold bg-red-500/20 text-red-300 border border-red-500/40"
          data-emergency-counter
        >
          {emergencyZones.length} Active
        </span>
      </div>
      <p class="text-xs text-slate-400 mt-1">
        Parking zones currently subject to emergency closures, safety cordons, or temporary restrictions.
      </p>
    </div>

    <div class="text-xs text-slate-400 flex items-center gap-1.5 self-start sm:self-center">
      <span class="w-2 h-2 rounded-full bg-red-400 animate-pulse"></span>
      <span class="text-red-300 font-medium">Automatic Safety Lock Active</span>
    </div>
  </div>

  <!-- Emergency Zones Grid -->
  <div
    class:list={[
      "grid grid-cols-1 md:grid-cols-2 gap-4",
      emergencyZones.length === 0 ? "hidden" : "",
    ]}
    data-emergency-grid
  >
    {emergencyZones.map((zone) => (
      <article
        class="glass-card p-4 sm:p-5 rounded-2xl border-red-500/40 bg-gradient-to-br from-red-950/30 via-slate-900/60 to-slate-900/80 flex flex-col justify-between gap-3 shadow-lg shadow-red-950/20"
        data-emergency-card
        data-zone-id={zone.id}
        data-zone-name={zone.name}
        data-zone-location={zone.location}
        data-emergency-status={zone.status}
        data-closure-reason={zone.reason}
      >
        <!-- Header: Zone Name, Location, Emergency Status Badge -->
        <div class="space-y-1.5">
          <div class="flex items-start justify-between gap-2.5">
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-1.5 flex-wrap">
                <h3 class="font-display text-base sm:text-lg font-bold text-white truncate">
                  {zone.name}
                </h3>
                <span class="text-xs text-slate-400 font-mono">#{zone.id}</span>
              </div>
              <!-- Location -->
              <p class="text-xs text-slate-300 flex items-center gap-1 mt-0.5 truncate">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-3.5 h-3.5 text-red-400 flex-shrink-0">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
                <span class="truncate">{zone.location}</span>
              </p>
            </div>

            <!-- Emergency Badge Indicator -->
            <span class:list={["inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-bold border whitespace-nowrap shadow-sm", zone.statusStyle]}>
              <span class="w-1.5 h-1.5 rounded-full bg-red-400 animate-ping"></span>
              <span>{zone.status}</span>
            </span>
          </div>

          <!-- Reason Box -->
          <div class="p-2.5 rounded-xl bg-red-950/40 border border-red-500/30 text-xs text-red-200 mt-2 space-y-1">
            <div class="flex items-center gap-1.5 font-semibold text-red-300">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-3.5 h-3.5 flex-shrink-0">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
              </svg>
              <span>Reason for closure:</span>
            </div>
            <p class="text-[11px] leading-relaxed text-red-200/90 pl-5">
              {zone.reason}
            </p>
          </div>
        </div>

        <!-- Space Impact Metric -->
        <div class="flex items-center justify-between text-xs py-2 px-3 rounded-xl bg-slate-900/60 border border-slate-800">
          <span class="text-slate-400 flex items-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-3.5 h-3.5 text-amber-400">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
            </svg>
            Affected Parking Spaces:
          </span>
          <span class="font-bold text-red-300 font-mono">
            {zone.affectedSpaces} of {zone.total_capacity} spaces offline
          </span>
        </div>

        <!-- Prevention warning + blocked button -->
        <div class="space-y-1.5 pt-1">
          <div class="text-[11px] text-red-300/80 flex items-center gap-1 justify-center font-medium">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-3 h-3 text-red-400">
              <rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            <span>Reservations strictly locked to safeguard drivers</span>
          </div>

          <button
            type="button"
            data-emergency-reserve-blocked
            data-zone-name={zone.name}
            data-closure-reason={zone.reason}
            class="w-full inline-flex items-center justify-center gap-2 px-3.5 py-2.5 rounded-xl font-semibold text-xs transition-all bg-red-950/60 text-red-300 border border-red-500/50 hover:bg-red-900/40 hover:border-red-400"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-3.5 h-3.5">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
            </svg>
            <span>Reservation Unavailable — Zone Blocked</span>
          </button>
        </div>
      </article>
    ))}
  </div>

  <!-- Clean Empty State when No Emergency Zones are Active -->
  <div
    class:list={[
      "glass-card p-6 sm:p-8 text-center rounded-2xl border-emerald-500/30 bg-gradient-to-br from-emerald-500/5 via-slate-900/40 to-transparent",
      emergencyZones.length > 0 ? "hidden" : "",
    ]}
    data-emergency-empty-state
  >
    <div class="w-12 h-12 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center mx-auto mb-3 text-emerald-400">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-6 h-6">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
        <polyline points="9 12 11 14 15 10"></polyline>
      </svg>
    </div>
    <h3 class="font-display text-base font-bold text-slate-100">
      All Parking Zones Operational
    </h3>
    <p class="text-xs text-slate-400 max-w-md mx-auto mt-1">
      No emergency closures, blocked zones, or temporary restrictions currently active. All facility parking spaces are operating normally.
    </p>
  </div>
</section>
