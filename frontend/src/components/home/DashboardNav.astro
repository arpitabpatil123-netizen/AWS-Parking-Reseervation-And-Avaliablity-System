---
// DashboardNav.astro
//
// Compact navigation bar for accessing parking zones and categories.
// Features:
//   - Category navigation tabs (All, EV Charging, General, Covered, Emergency)
//   - Responsive horizontal quick-jump zone strip
//   - Currently selected zone highlighting
//   - Live sync indicator

import type { ParkingZone } from "../../types/zone";
import { getZoneLocation } from "../../lib/utils";

interface Props {
  zones: ParkingZone[];
}

const { zones } = Astro.props;

const totalCount = zones.length;
const evCount = zones.filter((z) => z.type === "ev_charging").length;
const generalCount = zones.filter((z) => z.type === "general").length;
const coveredCount = zones.filter((z) => z.type === "covered").length;
const emergencyCount = zones.filter((z) => z.emergency_closed === true).length;

const navZonePills = zones.map((zone, idx) => ({
  id: zone.id,
  name: zone.name,
  type: zone.type,
  isEmergency: zone.emergency_closed === true,
  isFull: (zone.available_spots ?? 0) === 0,
  location: getZoneLocation(zone),
  isFirst: idx === 0,
}));
---

<nav
  class="glass-card mb-6 border-slate-700/60 p-3 md:p-4 rounded-2xl shadow-xl shadow-black/20"
  aria-label="Parking Zone Navigation"
  data-dashboard-nav
>
  <!-- Row 1: Primary category tabs + live sync indicator -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 pb-3 border-b border-slate-700/50">
    <div class="flex items-center gap-1.5 overflow-x-auto py-0.5 scrollbar-none" role="tablist" aria-label="Zone Categories">
      <!-- All Zones tab -->
      <button
        type="button"
        role="tab"
        aria-selected="true"
        data-nav-category="all"
        class="nav-tab active inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl text-xs sm:text-sm font-semibold transition-all border whitespace-nowrap bg-emerald-500/15 text-emerald-300 border-emerald-500/40 shadow-sm"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="w-4 h-4">
          <rect width="7" height="7" x="3" y="3" rx="1.5"></rect>
          <rect width="7" height="7" x="14" y="3" rx="1.5"></rect>
          <rect width="7" height="7" x="14" y="14" rx="1.5"></rect>
          <rect width="7" height="7" x="3" y="14" rx="1.5"></rect>
        </svg>
        <span>All Zones</span>
        <span class="px-1.5 py-0.2 rounded-md bg-emerald-500/20 text-[11px] font-bold" data-nav-count="all">{totalCount}</span>
      </button>

      <!-- EV Charging tab -->
      <button
        type="button"
        role="tab"
        aria-selected="false"
        data-nav-category="ev_charging"
        class="nav-tab inline-flex items-center gap-2 px-3 py-1.5 rounded-xl text-xs sm:text-sm font-medium transition-all border whitespace-nowrap bg-slate-800/60 text-slate-300 border-slate-700/60 hover:bg-slate-700/60 hover:text-slate-100"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="w-4 h-4 text-emerald-400">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
        </svg>
        <span>EV Charging</span>
        <span class="px-1.5 py-0.2 rounded-md bg-slate-700/60 text-[11px] font-semibold" data-nav-count="ev_charging">{evCount}</span>
      </button>

      <!-- General tab -->
      <button
        type="button"
        role="tab"
        aria-selected="false"
        data-nav-category="general"
        class="nav-tab inline-flex items-center gap-2 px-3 py-1.5 rounded-xl text-xs sm:text-sm font-medium transition-all border whitespace-nowrap bg-slate-800/60 text-slate-300 border-slate-700/60 hover:bg-slate-700/60 hover:text-slate-100"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="w-4 h-4 text-blue-400">
          <path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"></path>
          <circle cx="7" cy="17" r="2"></circle>
          <path d="M9 17h6"></path>
          <circle cx="17" cy="17" r="2"></circle>
        </svg>
        <span>General</span>
        <span class="px-1.5 py-0.2 rounded-md bg-slate-700/60 text-[11px] font-semibold" data-nav-count="general">{generalCount}</span>
      </button>

      <!-- Covered tab -->
      <button
        type="button"
        role="tab"
        aria-selected="false"
        data-nav-category="covered"
        class="nav-tab inline-flex items-center gap-2 px-3 py-1.5 rounded-xl text-xs sm:text-sm font-medium transition-all border whitespace-nowrap bg-slate-800/60 text-slate-300 border-slate-700/60 hover:bg-slate-700/60 hover:text-slate-100"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="w-4 h-4 text-purple-400">
          <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path>
        </svg>
        <span>Covered</span>
        <span class="px-1.5 py-0.2 rounded-md bg-slate-700/60 text-[11px] font-semibold" data-nav-count="covered">{coveredCount}</span>
      </button>

      <!-- Emergency tab -->
      <button
        type="button"
        role="tab"
        aria-selected="false"
        data-nav-category="emergency"
        class="nav-tab inline-flex items-center gap-2 px-3 py-1.5 rounded-xl text-xs sm:text-sm font-medium transition-all border whitespace-nowrap bg-red-500/10 text-red-300 border-red-500/30 hover:bg-red-500/20 hover:text-red-200"
      >
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-red-500"></span>
        </span>
        <span>Emergency</span>
        <span class="px-1.5 py-0.2 rounded-md bg-red-500/20 text-[11px] font-bold text-red-200" data-nav-count="emergency">{emergencyCount}</span>
      </button>
    </div>

    <!-- Live sync status -->
    <div class="flex items-center gap-2 text-xs text-slate-400 flex-shrink-0 self-end sm:self-center">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse-glow"></span>
      <span data-sync-label>Live System Online</span>
    </div>
  </div>

  <!-- Row 2: Quick Zone Navigation Strip (Horizontal compact pills for immediate zone access) -->
  <div class="pt-2.5">
    <div class="flex items-center justify-between gap-2 mb-1.5">
      <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-400 flex items-center gap-1.5">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-3.5 h-3.5 text-blue-400">
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 14 14"></polyline>
        </svg>
        Quick Zone Switcher
      </span>
      <span class="text-[11px] text-slate-500 hidden sm:inline">Click any zone to inspect parking spaces</span>
    </div>

    <div
      class="flex items-center gap-2 overflow-x-auto py-1 scrollbar-none"
      data-zone-nav-strip
      tabindex="0"
      aria-label="Individual Zone Switcher"
    >
      {navZonePills.map((zone) => (
        <button
          type="button"
          data-zone-jump={zone.id}
          data-zone-type={zone.type}
          data-zone-emergency={zone.isEmergency ? "true" : "false"}
          class:list={[
            "zone-pill inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-medium border whitespace-nowrap transition-all duration-200 flex-shrink-0",
            zone.isFirst
              ? "bg-emerald-500/15 text-emerald-200 border-emerald-500/40 ring-1 ring-emerald-500/30"
              : zone.isEmergency
              ? "bg-red-500/10 text-red-300 border-red-500/30 hover:bg-red-500/20"
              : zone.isFull
              ? "bg-slate-800/60 text-slate-400 border-slate-700/60 hover:bg-slate-700/60"
              : "bg-slate-800/40 text-slate-300 border-slate-700/50 hover:bg-slate-700/50 hover:text-slate-100",
          ]}
          title={`${zone.name} — ${zone.location}`}
        >
          <span
            class:list={[
              "w-1.5 h-1.5 rounded-full flex-shrink-0",
              zone.isEmergency ? "bg-red-400 animate-pulse" : zone.isFull ? "bg-slate-500" : "bg-emerald-400",
            ]}
          ></span>
          <span class="truncate max-w-[140px] sm:max-w-[180px]">{zone.name}</span>
          <span class="text-[10px] opacity-75 font-mono">#{zone.id}</span>
        </button>
      ))}
    </div>
  </div>
</nav>
