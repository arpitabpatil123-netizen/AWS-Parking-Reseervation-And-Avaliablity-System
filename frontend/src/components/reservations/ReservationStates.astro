---
// ReservationStates.astro
//
// Loading skeleton, empty-state, filter-empty-state, and error-state
// blocks for the My Reservations page. The four sections each have
// the `data-*` hooks the client controller toggles to swap visible
// sections. Pure presentational: no client-side script.
---

<section
  class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5"
  data-skeleton
  aria-hidden="true"
>
  {Array.from({ length: 3 }).map(() => (
    <div
      class="rounded-2xl border border-slate-800/80 bg-slate-900/60 backdrop-blur-md p-5 shadow-xl shadow-black/20 overflow-hidden"
    >
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-slate-800/60 animate-pulse"></div>
        <div class="flex-1 space-y-2">
          <div class="h-2 w-16 bg-slate-800/60 rounded animate-pulse"></div>
          <div class="h-3 w-32 bg-slate-800/60 rounded animate-pulse"></div>
        </div>
      </div>
      <div class="h-16 bg-slate-800/40 rounded-xl mt-4 animate-pulse"></div>
      <div class="flex justify-between mt-4">
        <div class="h-8 w-24 bg-slate-800/60 rounded-lg animate-pulse"></div>
        <div class="h-4 w-16 bg-slate-800/60 rounded animate-pulse"></div>
      </div>
    </div>
  ))}
</section>

<section
  class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 hidden"
  data-reservation-grid
  aria-live="polite"
></section>

<section
  class="hidden rounded-2xl border border-slate-800/80 bg-slate-900/60 backdrop-blur-md p-10 text-center shadow-xl shadow-black/20"
  data-filter-empty
  role="status"
>
  <div
    class="w-16 h-16 mx-auto rounded-2xl bg-slate-800/80 border border-slate-700/60 flex items-center justify-center mb-4"
    aria-hidden="true"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8 text-slate-400">
      <circle cx="11" cy="11" r="8"></circle>
      <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
    </svg>
  </div>
  <h2 class="font-display text-lg font-semibold text-slate-100">
    No matching reservations
  </h2>
  <p class="text-slate-400 mt-1 text-sm">
    Try a different filter or clear your search.
  </p>
</section>

<section
  class="hidden rounded-2xl border border-slate-800/80 bg-slate-900/60 backdrop-blur-md p-12 text-center shadow-xl shadow-black/20"
  data-empty-state
  role="status"
>
  <div
    class="w-24 h-24 mx-auto rounded-3xl bg-gradient-to-br from-emerald-500/20 via-blue-500/10 to-purple-500/15 border border-slate-700/60 flex items-center justify-center mb-6 shadow-inner"
    aria-hidden="true"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="w-12 h-12 text-emerald-300">
      <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
      <line x1="16" y1="2" x2="16" y2="6"></line>
      <line x1="8" y1="2" x2="8" y2="6"></line>
      <line x1="3" y1="10" x2="21" y2="10"></line>
    </svg>
  </div>
  <h2 class="font-display text-2xl font-bold text-slate-50">
    All caught up!
  </h2>
  <p class="text-slate-400 mt-2 max-w-md mx-auto">
    You haven't reserved any parking or EV charging spots yet. Browse
    the catalog and lock in your first spot in seconds.
  </p>
  <a
    href="/"
    class="mt-6 inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl text-sm font-semibold bg-gradient-to-r from-emerald-500 to-emerald-600 text-white shadow-lg shadow-emerald-500/30 hover:shadow-emerald-500/50 hover:from-emerald-400 hover:to-emerald-500 transition-all"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true">
      <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
    </svg>
    Browse Parking Zones
  </a>
</section>

<section
  class="hidden rounded-2xl border border-red-500/30 bg-red-950/20 backdrop-blur-md p-10 text-center shadow-xl shadow-red-500/10"
  data-error-state
  role="alert"
>
  <div
    class="w-16 h-16 mx-auto rounded-2xl bg-red-500/15 border border-red-500/30 flex items-center justify-center mb-4"
    aria-hidden="true"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8 text-red-300">
      <circle cx="12" cy="12" r="10"></circle>
      <line x1="12" y1="8" x2="12" y2="12"></line>
      <line x1="12" y1="16" x2="12.01" y2="16"></line>
    </svg>
  </div>
  <h2 class="font-display text-xl font-bold text-slate-50">
    Couldn't load your reservations
  </h2>
  <p class="text-slate-400 mt-2 max-w-md mx-auto" data-error-message>
    Please try again in a moment.
  </p>
  <button
    type="button"
    class="mt-5 inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl text-sm font-semibold bg-gradient-to-r from-blue-500 to-blue-600 text-white shadow-lg shadow-blue-500/30 hover:shadow-blue-500/50 hover:from-blue-400 hover:to-blue-500 transition-all"
    data-action="retry"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4" aria-hidden="true">
      <polyline points="23 4 23 10 17 10"></polyline>
      <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
    </svg>
    Try Again
  </button>
</section>