---
/**
 * Admin > Drivers (/admin/drivers)
 *
 * Thin shell — the live React island handles the driver list,
 * detail panel, and delete actions.
 *
 * `slot="fallback"` paints a loading skeleton that mirrors the final
 * layout (KPI strip + driver list panel + detail panel) so admins
 * see immediate content instead of an empty <main>.
 */

import Layout from "@/layouts/Layout.astro";
import AdminSidebar from "@/components/admin/AdminSidebar.astro";
import AdminPanel from "@/components/admin/AdminPanel.astro";
import AdminKpiCard from "@/components/admin/AdminKpiCard.astro";
import { DriversView } from "@/components/admin/DriversView";
---

<Layout
  title="Drivers — SpotSync Admin"
  description="Drivers who have made reservations and their booking history."
>
  <AdminSidebar
    title="Drivers"
    subtitle="Drivers who have reserved spots and their booking history."
  >
    <DriversView client:load>
      <div
        slot="fallback"
        class="admin-skeleton flex flex-col gap-6"
        aria-busy="true"
        aria-label="Loading drivers"
      >
        <!-- KPI strip -->
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
          <AdminKpiCard label="Total Drivers" icon="drivers" accent="blue" caption="Across all zones" />
          <AdminKpiCard label="Active Now" icon="active" accent="emerald" caption="Currently parked" />
          <AdminKpiCard label="Avg. Bookings" icon="reservations" accent="purple" caption="Per driver" />
        </div>

        <!-- Two-column layout: driver list (left) + detail panel (right) -->
        <div class="grid grid-cols-1 gap-4 lg:grid-cols-[2fr_1fr]">
          <!-- Driver list panel -->
          <AdminPanel title="Drivers" subtitle="Tap a driver to see their reservation history">
            <div class="flex flex-col gap-3">
              <div class="flex items-center gap-3 p-3 rounded-xl bg-[hsl(var(--surface-2)/0.5)]">
                <div class="h-11 w-11 shrink-0 rounded-full bg-[linear-gradient(90deg,hsl(var(--surface-2))_0%,hsl(var(--surface-3))_50%,hsl(var(--surface-2))_100%)] bg-[length:200%_100%] animate-admin-state-shimmer"></div>
                <div class="flex-1 flex flex-col gap-2">
                  <div class="h-3.5 w-1/3 rounded bg-[linear-gradient(90deg,hsl(var(--surface-2))_0%,hsl(var(--surface-3))_50%,hsl(var(--surface-2))_100%)] bg-[length:200%_100%] animate-admin-state-shimmer"></div>
                  <div class="h-2.5 w-1/2 rounded bg-[linear-gradient(90deg,hsl(var(--surface-2))_0%,hsl(var(--surface-3))_50%,hsl(var(--surface-2))_100%)] bg-[length:200%_100%] animate-admin-state-shimmer"></div>
                </div>
                <div class="h-6 w-16 rounded-full bg-[linear-gradient(90deg,hsl(var(--surface-2))_0%,hsl(var(--surface-3))_50%,hsl(var(--surface-2))_100%)] bg-[length:200%_100%] animate-admin-state-shimmer"></div>
              </div>
              <div class="flex items-center gap-3 p-3 rounded-xl bg-[hsl(var(--surface-2)/0.5)]">
                <div class="h-11 w-11 shrink-0 rounded-full bg-[linear-gradient(90deg,hsl(var(--surface-2))_0%,hsl(var(--surface-3))_50%,hsl(var(--surface-2))_100%)] bg-[length:200%_100%] animate-admin-state-shimmer"></div>
                <div class="flex-1 flex flex-col gap-2">
                  <div class="h-3.5 w-2/5 rounded bg-[linear-gradient(90deg,hsl(var(--surface-2))_0%,hsl(var(--surface-3))_50%,hsl(var(--surface-2))_100%)] bg-[length:200%_100%] animate-admin-state-shimmer"></div>
                  <div class="h-2.5 w-1/3 rounded bg-[linear-gradient(90deg,hsl(var(--surface-2))_0%,hsl(var(--surface-3))_50%,hsl(var(--surface-2))_100%)] bg-[length:200%_100%] animate-admin-state-shimmer"></div>
                </div>
                <div class="h-6 w-16 rounded-full bg-[linear-gradient(90deg,hsl(var(--surface-2))_0%,hsl(var(--surface-3))_50%,hsl(var(--surface-2))_100%)] bg-[length:200%_100%] animate-admin-state-shimmer"></div>
              </div>
              <div class="flex items-center gap-3 p-3 rounded-xl bg-[hsl(var(--surface-2)/0.5)]">
                <div class="h-11 w-11 shrink-0 rounded-full bg-[linear-gradient(90deg,hsl(var(--surface-2))_0%,hsl(var(--surface-3))_50%,hsl(var(--surface-2))_100%)] bg-[length:200%_100%] animate-admin-state-shimmer"></div>
                <div class="flex-1 flex flex-col gap-2">
                  <div class="h-3.5 w-1/4 rounded bg-[linear-gradient(90deg,hsl(var(--surface-2))_0%,hsl(var(--surface-3))_50%,hsl(var(--surface-2))_100%)] bg-[length:200%_100%] animate-admin-state-shimmer"></div>
                  <div class="h-2.5 w-2/5 rounded bg-[linear-gradient(90deg,hsl(var(--surface-2))_0%,hsl(var(--surface-3))_50%,hsl(var(--surface-2))_100%)] bg-[length:200%_100%] animate-admin-state-shimmer"></div>
                </div>
                <div class="h-6 w-16 rounded-full bg-[linear-gradient(90deg,hsl(var(--surface-2))_0%,hsl(var(--surface-3))_50%,hsl(var(--surface-2))_100%)] bg-[length:200%_100%] animate-admin-state-shimmer"></div>
              </div>
            </div>
            <span slot="footer">Loading driver list…</span>
          </AdminPanel>

          <!-- Detail panel placeholder -->
          <AdminPanel title="Driver details" subtitle="Select a driver to view their activity">
            <div class="flex flex-col gap-3">
              <div class="h-24 w-full rounded-xl bg-[linear-gradient(90deg,hsl(var(--surface-2))_0%,hsl(var(--surface-3))_50%,hsl(var(--surface-2))_100%)] bg-[length:200%_100%] animate-admin-state-shimmer"></div>
              <div class="h-16 w-full rounded-xl bg-[linear-gradient(90deg,hsl(var(--surface-2))_0%,hsl(var(--surface-3))_50%,hsl(var(--surface-2))_100%)] bg-[length:200%_100%] animate-admin-state-shimmer"></div>
              <div class="h-16 w-full rounded-xl bg-[linear-gradient(90deg,hsl(var(--surface-2))_0%,hsl(var(--surface-3))_50%,hsl(var(--surface-2))_100%)] bg-[length:200%_100%] animate-admin-state-shimmer"></div>
            </div>
            <span slot="footer">No driver selected</span>
          </AdminPanel>
        </div>
      </div>
    </DriversView>
  </AdminSidebar>
</Layout>