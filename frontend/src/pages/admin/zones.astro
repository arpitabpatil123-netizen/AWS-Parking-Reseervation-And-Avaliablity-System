---
/**
 * Admin > Parking Zones (/admin/zones)
 *
 * Thin shell — the live React island handles the grid, capacity
 * progress bars, and delete actions. The Create modal is kept as
 * an existing Astro component; we open it via a custom event so the
 * React island can stay decoupled from the modal's DOM.
 *
 * `slot="fallback"` paints a loading skeleton that mirrors the final
 * layout (search/filter bar + responsive zone card grid) so admins
 * see immediate content instead of an empty <main>.
 */

import Layout from "@/layouts/Layout.astro";
import AdminSidebar from "@/components/admin/AdminSidebar.astro";
import AdminPanel from "@/components/admin/AdminPanel.astro";
import AdminKpiCard from "@/components/admin/AdminKpiCard.astro";
import { ZonesGrid } from "@/components/admin/ZonesGrid";
import CreateZoneModal from "@/components/CreateZoneModal.astro";
---

<Layout
  title="Parking Zones — SpotSync Admin"
  description="Create, audit, and monitor every parking zone in the network."
>
  <AdminSidebar
    title="Parking Zones"
    subtitle="Create, audit, and monitor every parking zone in the network."
  >
    <ZonesGrid client:load>
      <div
        slot="fallback"
        class="admin-skeleton flex flex-col gap-6"
        aria-busy="true"
        aria-label="Loading parking zones"
      >
        <!-- KPI strip -->
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
          <AdminKpiCard label="Total Zones" icon="zones" accent="emerald" caption="Across the network" />
          <AdminKpiCard label="Total Spots" icon="spots" accent="blue" caption="All zones combined" />
          <AdminKpiCard label="Available" icon="available" accent="emerald" caption="Right now" />
          <AdminKpiCard label="EV Charging" icon="zones" accent="purple" caption="Dedicated stations" />
        </div>

        <!-- Toolbar + grid skeleton -->
        <AdminPanel title="All zones" subtitle="Manage capacity, type, and availability">
          <!-- Toolbar placeholder: search input + filter chips + create button -->
          <div class="flex flex-wrap items-center gap-3 mb-5">
            <div class="h-10 flex-1 min-w-[12rem] rounded-xl bg-[linear-gradient(90deg,hsl(var(--surface-2))_0%,hsl(var(--surface-3))_50%,hsl(var(--surface-2))_100%)] bg-[length:200%_100%] animate-admin-state-shimmer"></div>
            <div class="h-10 w-24 rounded-xl bg-[linear-gradient(90deg,hsl(var(--surface-2))_0%,hsl(var(--surface-3))_50%,hsl(var(--surface-2))_100%)] bg-[length:200%_100%] animate-admin-state-shimmer"></div>
            <div class="h-10 w-32 rounded-xl bg-[linear-gradient(90deg,hsl(var(--surface-2))_0%,hsl(var(--surface-3))_50%,hsl(var(--surface-2))_100%)] bg-[length:200%_100%] animate-admin-state-shimmer"></div>
          </div>

          <!-- Zone card grid skeleton -->
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {Array.from({ length: 6 }).map(() => (
              <div class="flex flex-col gap-3 rounded-2xl border border-[hsl(var(--surface-3))] bg-[hsl(var(--surface-2)/0.4)] p-5">
                <div class="flex items-center justify-between gap-2">
                  <div class="h-4 w-1/3 rounded bg-[linear-gradient(90deg,hsl(var(--surface-2))_0%,hsl(var(--surface-3))_50%,hsl(var(--surface-2))_100%)] bg-[length:200%_100%] animate-admin-state-shimmer"></div>
                  <div class="h-6 w-16 rounded-full bg-[linear-gradient(90deg,hsl(var(--surface-2))_0%,hsl(var(--surface-3))_50%,hsl(var(--surface-2))_100%)] bg-[length:200%_100%] animate-admin-state-shimmer"></div>
                </div>
                <div class="h-3 w-2/3 rounded bg-[linear-gradient(90deg,hsl(var(--surface-2))_0%,hsl(var(--surface-3))_50%,hsl(var(--surface-2))_100%)] bg-[length:200%_100%] animate-admin-state-shimmer"></div>
                <div class="h-2.5 w-full rounded-full bg-[linear-gradient(90deg,hsl(var(--surface-2))_0%,hsl(var(--surface-3))_50%,hsl(var(--surface-2))_100%)] bg-[length:200%_100%] animate-admin-state-shimmer"></div>
                <div class="flex items-center justify-between gap-2">
                  <div class="h-3 w-1/4 rounded bg-[linear-gradient(90deg,hsl(var(--surface-2))_0%,hsl(var(--surface-3))_50%,hsl(var(--surface-2))_100%)] bg-[length:200%_100%] animate-admin-state-shimmer"></div>
                  <div class="h-3 w-12 rounded bg-[linear-gradient(90deg,hsl(var(--surface-2))_0%,hsl(var(--surface-3))_50%,hsl(var(--surface-2))_100%)] bg-[length:200%_100%] animate-admin-state-shimmer"></div>
                </div>
              </div>
            ))}
          </div>

          <span slot="footer">Loading zones…</span>
        </AdminPanel>
      </div>
    </ZonesGrid>
  </AdminSidebar>
  <CreateZoneModal />
</Layout>