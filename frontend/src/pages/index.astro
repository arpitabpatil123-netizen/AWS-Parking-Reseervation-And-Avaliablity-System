---
// index.astro — SpotSync User Dashboard.
//
// Modern, compact parking-management dashboard organized in the specified order:
//   1. Compact navigation bar (DashboardNav)
//   2. Small summary section showing Available Spaces, Occupied Spaces, and Emergency Zones (DashboardSummary)
//   3. Search and filter section (DashboardFilter)
//   4. All Parking Zones section (AllZonesSection)
//   5. Emergency Zones section (EmergencyZonesSection)
//   6. My Active Reservations section (DashboardReservations)
//
// Zone data is fetched server-side for fast first paint, with reactive
// client-side controllers handling real-time search, filters, modals,
// reservations, and auto-sync updates.

import Layout from "@/layouts/Layout.astro";
import DashboardNav from "@/components/home/DashboardNav.astro";
import DashboardSummary from "@/components/home/DashboardSummary.astro";
import DashboardFilter from "@/components/home/DashboardFilter.astro";
import AllZonesSection from "@/components/home/AllZonesSection.astro";
import EmergencyZonesSection from "@/components/home/EmergencyZonesSection.astro";
import { DashboardReservations } from "@/components/home/DashboardReservations";
import ReserveModal from "@/components/ReserveModal.astro";
import { getZones } from "@/services/zoneService";
import { getMockZones } from "@/services/mockZoneData";
import { ApiError } from "@/services/api";
import type { ParkingZone } from "@/types/zone";

const USE_MOCK_DATA = false;

let zones: ParkingZone[] = [];
let fetchError: string | null = null;

if (USE_MOCK_DATA) {
  zones = await getMockZones();
} else {
  try {
    zones = await getZones();
  } catch (error) {
    if (error instanceof ApiError) {
      fetchError = error.message;
    } else if (error instanceof Error) {
      fetchError = error.message;
    } else {
      fetchError = "Could not load zones from the SpotSync API.";
    }
    zones = await getMockZones();
  }
}
---

<Layout title="User Dashboard — SpotSync Real-Time Parking & EV Hub">
  <main class="relative container mx-auto px-4 py-5 md:py-6 max-w-7xl">
    <!-- Ambient decorative blobs -->
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 overflow-hidden">
      <div class="absolute -top-20 -left-20 w-80 h-80 bg-emerald-500/10 rounded-full blur-3xl"></div>
      <div class="absolute top-1/3 -right-20 w-80 h-80 bg-blue-500/10 rounded-full blur-3xl"></div>
      <div class="absolute bottom-10 left-1/4 w-80 h-80 bg-purple-500/5 rounded-full blur-3xl"></div>
    </div>

    <!-- 1. Compact Navigation Bar -->
    <DashboardNav zones={zones} />

    <!-- 2. Small Summary Section (Available Spaces, Occupied Spaces, Emergency Zones) -->
    <DashboardSummary zones={zones} />

    <!-- 3. Search and Filter Section -->
    <DashboardFilter />

    <!-- 4. All Parking Zones Section -->
    <AllZonesSection zones={zones} fetchError={fetchError} />

    <!-- 5. Emergency Zones Section -->
    <EmergencyZonesSection zones={zones} />

    <!-- 6. My Active Reservations Section -->
    <DashboardReservations client:load />

    <!-- Reservation Modal -->
    <ReserveModal />
  </main>
</Layout>

<script>
  // Dashboard client-side controllers
  import "@/scripts/home/index";
</script>
