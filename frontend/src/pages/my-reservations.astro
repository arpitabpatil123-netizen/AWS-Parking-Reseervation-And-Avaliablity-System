---
// My Reservations page (`/my-reservations`).
//
// Driver-facing dashboard showing every booking the current user has
// made. Auth-guarded at the top of the client script: an unauthenticated
// visitor is bounced to `/login` before any data load happens.
//
// Layout (top to bottom):
//   1. Header bar with title, subtitle, live pulse, refresh button.
//   2. 4-up KPI strip (Total / Active / Cancelled / Latest).
//   3. Toolbar: search-by-plate input + filter segmented pills.
//   4. State sections: skeleton / grid / filter-empty / empty / error.
//   5. Cancel-confirmation dialog.
//   6. Ambient glow background.
//
// The page is statically rendered — the JWT goes on the next request
// automatically so the API call is performed client-side.

import Layout from "@/layouts/Layout.astro";
import ReservationHeader from "@/components/reservations/ReservationHeader.astro";
import ReservationKpiStrip from "@/components/reservations/ReservationKpiStrip.astro";
import ReservationToolbar from "@/components/reservations/ReservationToolbar.astro";
import ReservationStates from "@/components/reservations/ReservationStates.astro";
import CancelReservationDialog from "@/components/reservations/CancelReservationDialog.astro";
---

<Layout
  title="My Reservations — SpotSync"
  description="View and manage your parking and EV charging reservations in real time."
>
  <main class="relative container mx-auto px-4 py-10 max-w-6xl">
    <!-- Ambient glow background (preserved verbatim from the previous
         inline markup; identical to the original page.) -->
    <div
      class="pointer-events-none absolute inset-0 -z-10 overflow-hidden"
      aria-hidden="true"
    >
      <div
        class="absolute -top-32 left-1/2 -translate-x-1/2 w-[42rem] h-[42rem] rounded-full bg-emerald-500/10 blur-3xl"
      >
      </div>
      <div
        class="absolute top-1/3 right-0 w-[28rem] h-[28rem] rounded-full bg-blue-500/10 blur-3xl"
      >
      </div>
      <div
        class="absolute bottom-0 left-1/4 w-[24rem] h-[24rem] rounded-full bg-purple-500/5 blur-3xl"
      >
      </div>
    </div>

    <ReservationHeader />
    <ReservationKpiStrip />
    <ReservationToolbar />
    <ReservationStates />
    <CancelReservationDialog />
  </main>
</Layout>

<script>
  // My Reservations client controller.
  //
  // The previous single-file implementation was moved into focused
  // modules under `@/scripts/reservations/`. Each module preserves
  // the original behavior (auth guard, fetch, filter, search,
  // cancel-flow with optimistic update + rollback, relative-time
  // refresh, error/empty states) exactly. This entry point just
  // boots them in order.
  import "@/scripts/reservations/index";
</script>